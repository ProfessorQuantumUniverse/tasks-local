# ─────────────────────────────────────────────────────────────────────────
#  Tasks - self-hosted configuration
#  Copy to .env (or paste these into Portainer's stack environment editor).
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED. The exact origin you open in the browser, no trailing slash.
# Passkeys are cryptographically bound to this hostname: if you change it
# later, every registered passkey stops working and you have to re-enroll.
# Must be https:// - browsers refuse WebAuthn on plain http.
APP_ORIGIN=https://tasks.example.com

# Name of the Docker network your Nginx Proxy Manager container is on.
# Find it with:  docker network ls
PROXY_NETWORK=npm_default

# Shown in the OS passkey prompt ("Passkey für <RP_NAME> speichern?").
RP_NAME=Tasks
ACCOUNT_DISPLAY_NAME=Tasks

# How long you stay signed in. The token rotates every SESSION_ROTATE_HOURS.
SESSION_TTL_DAYS=30
SESSION_ROTATE_HOURS=24

# Lifetime of a token that authorises registering a new passkey.
ENROLLMENT_TOKEN_TTL_MINUTES=15

# Local time zone: decides what counts as "today" for due dates.
TZ=Europe/Berlin

# Which sources may set X-Forwarded-For. The default trusts private ranges
# only, which is correct when the proxy sits on a Docker network. Do not set
# this to "true" on a publicly reachable port: it would let anyone spoof
# their address and slip past the rate limits.
TRUST_PROXY=loopback,linklocal,uniquelocal

# info | warn | error | debug
LOG_LEVEL=info

# Name of the Docker volume holding the SQLite database.
DATA_VOLUME=tasks-data

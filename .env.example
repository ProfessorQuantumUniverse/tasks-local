# ─────────────────────────────────────────────────────────────────────────
#  Tasks - self-hosted configuration
#  Copy to .env (or paste these into Portainer's stack environment editor).
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED. The exact origin you open in the browser, no trailing slash.
# Passkeys are cryptographically bound to this hostname: if you change it
# later, every registered passkey stops working and you have to re-enroll.
# Must be https:// - browsers refuse WebAuthn on plain http.
APP_ORIGIN=https://tasks.example.com

# Where the container's port lands on the Docker host. Point your reverse
# proxy at <docker-host-ip>:<HOST_PORT>.
#
# BIND_ADDR restricts the listener to one interface. 0.0.0.0 is fine when the
# host has a single address; set the LAN address explicitly if it has more.
BIND_ADDR=0.0.0.0
HOST_PORT=8080

# Shown in the OS passkey prompt ("Passkey für <RP_NAME> speichern?").
RP_NAME=Tasks
ACCOUNT_DISPLAY_NAME=Tasks

# How long you stay signed in. The token rotates every SESSION_ROTATE_HOURS.
SESSION_TTL_DAYS=30
SESSION_ROTATE_HOURS=24

# Lifetime of a token that authorises registering a new passkey.
ENROLLMENT_TOKEN_TTL_MINUTES=15

# Local time zone: decides what counts as "today" for due dates.
TZ=Europe/Berlin

# Which sources may set X-Forwarded-For.
#
# SET THIS to the IP of your reverse proxy, e.g.
#   TRUST_PROXY=192.168.1.40
#
# Without it the app sees every request as coming from the proxy: rate limits
# then apply to all your devices together and the audit log records the
# proxy's address instead of the real client's. Nothing breaks, you just lose
# the detail.
#
# Do NOT use "loopback,linklocal,uniquelocal" here: the port is published on
# the LAN, so every host on the LAN is inside a private range and could forge
# the header to slip past the rate limits. And never "true".
TRUST_PROXY=false

# info | warn | error | debug
LOG_LEVEL=info

# Name of the Docker volume holding the SQLite database.
DATA_VOLUME=tasks-data
